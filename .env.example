# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: comma-separated emails that receive admin role on signup
ADMIN_EMAILS=admin@example.com

# Optional: Google OAuth (email/password signup works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_ID=4

# Optional: AWS S3 for media uploads (local ./media/ is used when unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2

# Production only (set automatically on Heroku)
# DATABASE_URL=postgres://...
